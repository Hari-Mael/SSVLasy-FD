<Project Sdk="Godot.NET.Sdk/4.3.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Sahavola</AssemblyName>
    <RootNamespace>Sahavola</RootNamespace>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <!-- Le noyau partagé (core/) est un projet à part, réutilisé par Unity :
       le projet Godot ne doit pas le compiler une seconde fois. -->
  <ItemGroup>
    <Compile Remove="core/**" />
    <Compile Remove="backend/**" />
  </ItemGroup>
</Project>
